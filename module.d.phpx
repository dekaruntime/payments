import { Result } from 'core/result'

type ConnectedAccount = {
  provider: string,
  account_id: string,
  charges_enabled: bool,
  onboarded_at: int,
  metadata: mixed,
}

type Charge = {
  id: string,
  provider: string,
  amount_cents: int,
  currency: string,
  platform_fee_cents: int,
  status: string,
}

type Refund = {
  id: string,
  provider: string,
  charge_id: string,
  amount_cents: int,
  status: string,
}

type Event = {
  id: string,
  provider: string,
  type: string,
  created_at: int,
  data: mixed,
}

type AccountStatus = {
  provider: string,
  account_id: string,
  charges_enabled: bool,
  disabled_reason: string,
  requirements_due: mixed,
}

// Fee math.

/// docid: phpx/payments/platform_fee_cents()
/// <Function name="platform_fee_cents">
///   <Description>PHPX standard module function `platform_fee_cents` from `payments`.</Description>
///   <Parameter name="$amount_cents" type="int" required="true" typeLink="/docs/php/types/int">
///     Parameter $amount_cents.
///   </Parameter>
///   <Parameter name="$tier" type="string" required="true" typeLink="/docs/php/types/string">
///     Parameter $tier.
///   </Parameter>
///   <ReturnType type="int" typeLink="/docs/php/types/int" />
/// </Function>
export function platform_fee_cents($amount_cents: int, $tier: string): int

